//           add(ApexIntegrityPackage())
//       }
//
// And set CLOUD_PROJECT_NUMBER in ApexIntegrityModule.kt to the Google Cloud
// project number linked to this app's Play Console entry. Without it,
// attestation resolves UNAVAILABLE and the server falls back to the local
// signals alone.
