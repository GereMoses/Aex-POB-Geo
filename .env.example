# Copy this file to .env and fill in real values before running docker-compose.
# .env is gitignored — never commit it.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=pob_system
POSTGRES_USER=pob_user
POSTGRES_PASSWORD=change_me_in_production

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be the same value set in backend/.env SECRET_KEY
SECRET_KEY=change_me_to_a_long_random_string

# ── Allowed hosts (comma-separated, used by TrustedHostMiddleware) ────────────
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS origins (comma-separated) ───────────────────────────────────────────
# Add your production domain here for deployment (localhost variants kept for dev)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production example: BACKEND_CORS_ORIGINS=https://pob.yourcompany.com

# ── Email notifications (emergency + mustering alerts) ───────────────────────
# Fill these in and restart the backend to turn on email alerts. Empty = off
# (nothing sends). Gmail: create an App Password (Google account → Security →
# 2-Step Verification → App passwords) and use it as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true

# ── SMS + WhatsApp (OFF by default) ──────────────────────────────────────────
# There is NO free cloud SMS/WhatsApp gateway — every provider charges to deliver.
# Leave SMS_PROVIDER empty to keep them off (email + in-app/PA alerts still work).
#
# Free/open-source routes are SELF-HOSTED and have caveats:
#   • SMS      → android-sms-gateway (Apache-2.0) on a phone+SIM, or Gammu+GSM modem.
#                Point SMS_API_URL at it and set SMS_PROVIDER=generic.
#   • WhatsApp → a Baileys / whatsapp-web.js gateway using your own number
#                (unofficial — Meta can ban it). Point WHATSAPP_API_URL at it.
# Paid options if you ever need them: SMS_PROVIDER=termii | twilio | africastalking.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_CHANNEL=generic
SMS_DEFAULT_COUNTRY_CODE=234
TERMII_BASE_URL=https://api.ng.termii.com

WHATSAPP_PROVIDER=
WHATSAPP_SENDER_ID=

# ── Generic HTTP gateway (SMS_PROVIDER=generic) ──────────────────────────────
# Works with the free SELF-HOSTED gateways (an Android phone + SIM acting as the
# modem). There is still no free CLOUD SMS API — these avoid per-message fees by
# using your own SIM and airtime.
#
#   httpSMS   SMS_API_URL=https://<host>/v1/messages/send
#             SMS_API_KEY_HEADER=x-api-key
#             SMS_FIELD_MESSAGE=content
#
#   textbee   SMS_API_URL=https://<host>/api/v1/gateway/devices/<id>/send-sms
#             SMS_API_KEY_HEADER=x-api-key
#             SMS_FIELD_TO=recipients
#             SMS_BATCH_RECIPIENTS=true
#
#   SMSGate   SMS_API_URL=https://<host>/message
#             SMS_API_HEADERS={"Authorization":"Basic <base64 user:pass>"}
#             SMS_FIELD_TO=phoneNumbers
#             SMS_BATCH_RECIPIENTS=true
#
# Defaults (no extra vars) POST {"api_key","to","message"}.
SMS_API_URL=
SMS_API_KEY_HEADER=
SMS_API_HEADERS=
SMS_FIELD_TO=
SMS_FIELD_MESSAGE=
SMS_FIELD_FROM=
SMS_BATCH_RECIPIENTS=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Person-to-person WhatsApp is free, but sending from a SERVER is not the same
# thing. Two routes, neither of which is both free and suitable for emergencies:
#
#   Official (Meta Cloud API) — no subscription fee, but an emergency alert is a
#   BUSINESS-INITIATED template message, and those are charged in every market.
#   From 1 Oct 2026 the previously-free in-window service messages are charged
#   too. Reliable, ToS-compliant, has delivery receipts.
#
#   Self-hosted (Evolution API / WAHA / Baileys) on your own SIM — genuinely free
#   beyond airtime, and it does work. But it drives an UNOFFICIAL client, which
#   breaches Meta's terms: such numbers are widely reported banned within 2–8
#   weeks, and bulk sending to many recipients at once is exactly the pattern
#   Meta's automated detection looks for. It also breaks whenever Meta changes
#   the protocol. Fine as a convenience channel; NEVER as the only route for a
#   muster or emergency alert.
#
#   Evolution API   WHATSAPP_API_URL=https://<host>/message/sendText/<instance>
#                   WHATSAPP_API_KEY_HEADER=apikey
#                   WHATSAPP_FIELD_TO=number
#                   WHATSAPP_FIELD_MESSAGE=text
#
#   WAHA            WHATSAPP_API_URL=https://<host>/api/sendText
#                   WHATSAPP_FIELD_TO=chatId
#                   WHATSAPP_FIELD_MESSAGE=text
#                   WHATSAPP_EXTRA_BODY={"session":"default"}
#
# Defaults (no extra vars) POST {"api_key","to","message"}.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_API_KEY_HEADER=
WHATSAPP_API_HEADERS=
WHATSAPP_FIELD_TO=
WHATSAPP_FIELD_MESSAGE=
WHATSAPP_EXTRA_BODY=

# Twilio (paid — only if SMS_PROVIDER=twilio):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM_NUMBER=
WHATSAPP_FROM=                     # e.g. whatsapp:+14155238886

# Africa's Talking (paid — only if SMS_PROVIDER=africastalking):
AT_USERNAME=
